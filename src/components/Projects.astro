---
import { PROJECTS } from "@/constants";
import Project from "./Project.astro";
---

<section
  id="projects"
  class="grid scroll-mt-16 grid-cols-1 gap-x-10 gap-y-4 lg:grid-cols-[9rem_minmax(0,1fr)]"
>
  <h2 class="text-3xl font-bold lg:text-right">PROJECTS</h2>
  <ul class="min-w-0 border-t border-foreground/20">
    {PROJECTS.map(item => <Project {...item} />)}
  </ul>
</section>

<style>
  #projects {
    scroll-margin-top: 5rem;
  }
</style>
