---
import ThemeToggle from "@/components/ThemeToggle.astro";
import { SITE } from "@/config";
---

<header
  class="fixed top-0 z-10 flex min-h-14 w-full items-center bg-muted px-4"
>
  <p class="flex-1 text-2xl">
    <a href="/" transition:name="site-title" transition:animate="slide"
      >{SITE.title}</a
    >
  </p>
  <nav aria-label="Main navigation" class="grid grid-cols-2 items-center gap-4">
    <a
      class="text-center font-medium decoration-1 underline-offset-4 hover:underline focus-visible:underline"
      href="/posts">Blogs</a
    >
    <ThemeToggle />
  </nav>
</header>
